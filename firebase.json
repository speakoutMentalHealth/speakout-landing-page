{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080,
      "websocketPort": 9150
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".gitignore",
      ".github/**",
      ".firebase/**",
      "firebase-debug.log",
      "node_modules/**",
      "package.json",
      "package-lock.json",
      "functions/**",
      "workers/**",
      "tests/**",
      "demo/**",
      "speakout-landing-page/**",
      "firestore-schema/**",
      "firestore-seed/*.mjs",
      "firestore-seed/help.md",
      "firestore-seed/*-starter.json",
      "firestore-seed/all-starter-content.json",
      "firestore-seed/student-wellbeing-*.json",
      "docs/**",
      "*.md",
      "INSTALLATION_GUIDE.txt",
            "INSTALL_GUIDE.txt",
            "PHASE-3-5-QA-REPORT.txt",
            "PORTAL-REVAMP-NOTES.txt",
            "README.txt",
            "SPEAKHUB-V5-DEPLOYMENT.txt",
            "firestore-rules.txt",
            "js/AUTH-GUARD-PATCH.txt",
      "books-seed.json",
      "courses-seed.json",
      "legal-elibrary-books.json",
      "*.bundle",
      "secure-assessment-migration.html",
      "seed-*.html",
      "seed-*.js",
      "cleanup-books.html",
      "cleanup-books.js"
    ],
    "redirects": [
      { "source": "/portal/courses/**", "destination": "/my-courses.html", "type": 302 },
      { "source": "/portal/library/**", "destination": "/my-library.html", "type": 302 },
      { "source": "/portal/progress/**", "destination": "/progress.html", "type": 302 },
      { "source": "/portal/certificates/**", "destination": "/certificates.html", "type": 302 },
      { "source": "/portal/workshops/**", "destination": "/workshops.html", "type": 302 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ]
  }
}
