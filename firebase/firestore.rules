rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
function isSignedIn(){return request.auth!=null;} function userExists(){return isSignedIn()&&exists(/databases/$(database)/documents/users/$(request.auth.uid));} function userDoc(){return get(/databases/$(database)/documents/users/$(request.auth.uid));} function userRole(){return userExists()?userDoc().data.role:"";} function userSchoolId(){return userExists()?userDoc().data.schoolId:"";} function isApproved(){return userExists()&&userDoc().data.status=="approved";} function isSuperAdmin(){return isApproved()&&(userRole()=="super_admin"||userRole()=="admin");} function isSchoolAdmin(){return isApproved()&&userRole()=="school_admin";} function isTeacher(){return isApproved()&&userRole()=="teacher";} function isParent(){return isApproved()&&userRole()=="parent";} function isStudent(){return isApproved()&&userRole()=="student";} function isPublicRole(role){return role in ["student","parent","teacher","school","school_admin","ambassador","contributor","volunteer"];}
function validNewUser(id){return request.resource.data.keys().hasAll(["uid","email","role","status","approved"])&&request.resource.data.uid==id&&request.auth.uid==id&&request.resource.data.status=="pending"&&request.resource.data.approved==false&&isPublicRole(request.resource.data.role)&&request.resource.data.email is string;} function onlyEditableProfileFieldsChanged(){return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["firstName","lastName","fullName","phone","country","state","city","location","occupation","bio","photoURL","profileCompleted","updatedAt"]);} function isUserInSchool(uid,sid){return exists(/databases/$(database)/documents/users/$(uid))&&get(/databases/$(database)/documents/users/$(uid)).data.schoolId==sid;}
match /users/{id}{allow create:if isSignedIn()&&request.auth.uid==id&&validNewUser(id);allow read:if isApproved()&&(request.auth.uid==id||isSuperAdmin()||(isSchoolAdmin()&&resource.data.schoolId==userSchoolId()));allow update:if isSuperAdmin()||(isApproved()&&request.auth.uid==id&&onlyEditableProfileFieldsChanged());allow delete:if isSuperAdmin();}
match /schools/{id}{allow create:if isSuperAdmin();allow read:if isApproved()&&(isSuperAdmin()||(isSchoolAdmin()&&userSchoolId()==id)||((isTeacher()||isParent()||isStudent())&&userSchoolId()==id));allow update:if isSuperAdmin()||(isSchoolAdmin()&&userSchoolId()==id);allow delete:if isSuperAdmin();}
match /parentStudentLinks/{id}{allow create:if isSuperAdmin()||(isApproved()&&request.resource.data.schoolId==userSchoolId()&&isUserInSchool(request.resource.data.studentId,userSchoolId())&&((isSchoolAdmin()&&isUserInSchool(request.resource.data.parentId,userSchoolId()))||(isParent()&&request.resource.data.parentId==request.auth.uid)));allow read:if isApproved()&&(isSuperAdmin()||(isSchoolAdmin()&&resource.data.schoolId==userSchoolId())||resource.data.parentId==request.auth.uid||resource.data.studentId==request.auth.uid);allow update:if isSuperAdmin()||(isSchoolAdmin()&&resource.data.schoolId==userSchoolId()&&request.resource.data.schoolId==userSchoolId()&&request.resource.data.parentId==resource.data.parentId&&request.resource.data.studentId==resource.data.studentId);allow delete:if isSuperAdmin()||(isSchoolAdmin()&&resource.data.schoolId==userSchoolId());}
match /books/{id}{allow read:if true;allow write:if isSuperAdmin();} match /bookSubmissions/{id}{allow create:if isSignedIn()&&request.resource.data.submittedBy==request.auth.uid&&request.resource.data.status=="pending";allow read:if isSignedIn()&&(resource.data.submittedBy==request.auth.uid||isSuperAdmin());allow update,delete:if isSuperAdmin();}
match /parentResources/{id}{allow read:if isApproved()&&(isParent()||isSchoolAdmin()||isSuperAdmin());allow write:if isSuperAdmin();} match /teacherResources/{id}{allow read:if isApproved()&&(isTeacher()||isSchoolAdmin()||isSuperAdmin());allow write:if isSuperAdmin();} match /studentResources/{id}{allow read:if isApproved()&&(isStudent()||isTeacher()||isSchoolAdmin()||isSuperAdmin());allow write:if isSuperAdmin();}
match /schoolResources/{id}{allow read:if isApproved()&&(isSuperAdmin()||(resource.data.schoolId==userSchoolId()&&(isSchoolAdmin()||isTeacher()||isParent()||isStudent())));allow create:if isSuperAdmin()||(isSchoolAdmin()&&request.resource.data.schoolId==userSchoolId());allow update:if isSuperAdmin()||(isSchoolAdmin()&&resource.data.schoolId==userSchoolId()&&request.resource.data.schoolId==userSchoolId());allow delete:if isSuperAdmin()||(isSchoolAdmin()&&resource.data.schoolId==userSchoolId());}
match /workshops/{id}{allow read:if isApproved()&&(isSuperAdmin()||(resource.data.schoolId==userSchoolId()&&(isSchoolAdmin()||isTeacher()||isParent()||isStudent())));allow create:if isSuperAdmin()||(isSchoolAdmin()&&request.resource.data.schoolId==userSchoolId());allow update:if isSuperAdmin()||(isSchoolAdmin()&&resource.data.schoolId==userSchoolId()&&request.resource.data.schoolId==userSchoolId());allow delete:if isSuperAdmin()||(isSchoolAdmin()&&resource.data.schoolId==userSchoolId());}
match /courses/{id}{allow read:if isApproved();allow write:if isSuperAdmin();} match /courseModules/{id}{allow read:if isApproved();allow write:if isSuperAdmin();} match /courseLessons/{id}{allow read:if isApproved();allow write:if isSuperAdmin();} match /courseAssessments/{id}{allow read,write:if false;} match /userProgress/{id}{allow read:if isApproved()&&(resource.data.userId==request.auth.uid||isSuperAdmin());allow write:if isSuperAdmin();} match /readingProgress/{id}{allow read:if isApproved()&&resource.data.userId==request.auth.uid;allow create:if isApproved()&&request.resource.data.userId==request.auth.uid&&request.resource.data.type in ["book","kiddies"];allow update:if isApproved()&&resource.data.userId==request.auth.uid&&request.resource.data.userId==request.auth.uid&&request.resource.data.type in ["book","kiddies"];allow delete:if isApproved()&&resource.data.userId==request.auth.uid;}
match /certificates/{id}{allow read:if isSuperAdmin()||(isApproved()&&resource.data.userId==request.auth.uid);allow create,update,delete:if isSuperAdmin();} match /publicCertificateVerifications/{id}{allow read:if true;allow write:if isSuperAdmin();} match /certificateTemplates/{id}{allow read:if isApproved();allow write:if isSuperAdmin();} match /externalLearningRecords/{id}{allow read:if isApproved()&&(resource.data.userId==request.auth.uid||isSuperAdmin());allow create,update,delete:if isSuperAdmin();} match /contributors/{id}{allow read:if isApproved();allow write:if isSuperAdmin();} match /contributorApplications/{id}{allow create:if isSignedIn();allow read,update,delete:if isSuperAdmin();} match /kiddiesResources/{id}{allow read:if isApproved()&&(isStudent()||isParent()||isTeacher()||isSchoolAdmin()||isSuperAdmin());allow write:if isSuperAdmin();} match /homepageMedia/{id}{allow read:if true;allow write:if isSuperAdmin();} match /newsEvents/{id}{allow read:if true;allow write:if isSuperAdmin();}
match /payments/{id}{allow create:if isApproved()&&request.resource.data.userId==request.auth.uid&&request.resource.data.status=="pending";allow read:if isSuperAdmin()||(isApproved()&&resource.data.userId==request.auth.uid);allow update,delete:if isSuperAdmin();} match /donations/{id}{allow create:if true;allow read,update,delete:if isSuperAdmin();} match /contactMessages/{id}{allow create:if true;allow read,update,delete:if isSuperAdmin();} match /schoolApplications/{id}{allow create:if true;allow read,update,delete:if isSuperAdmin();}
function validOTM(id){return request.resource.data.keys().hasAll(["applicationId","organizationName","organizationType","country","state","city","contactName","contactRole","email","phone","program","audience","ageRange","expectedReach","reason","needs","venue","logistics","funding","clubInterest","partnershipInterest","declaration","status","source","createdAt","updatedAt"])&&request.resource.data.keys().hasOnly(["applicationId","organizationName","organizationType","website","country","state","city","contactName","contactRole","email","phone","program","audience","ageRange","expectedReach","reason","needs","preferredDate","alternativeDate","venue","logistics","facilities","funding","clubInterest","partnershipInterest","declaration","status","source","createdAt","updatedAt"])&&request.resource.data.applicationId==id&&id.matches('SOM-[0-9]{8}-[A-F0-9]{8}')&&request.resource.data.status=="new"&&request.resource.data.source=="on-the-move-web"&&request.resource.data.declaration==true&&request.resource.data.organizationName is string&&request.resource.data.organizationName.size()>=2&&request.resource.data.organizationName.size()<=120&&request.resource.data.email is string&&request.resource.data.email.size()>=5&&request.resource.data.email.size()<=160&&request.resource.data.phone is string&&request.resource.data.phone.size()>=5&&request.resource.data.phone.size()<=40&&request.resource.data.reason is string&&request.resource.data.reason.size()>=30&&request.resource.data.reason.size()<=1500&&request.resource.data.needs is string&&request.resource.data.needs.size()>=20&&request.resource.data.needs.size()<=1500&&request.resource.data.expectedReach is number&&request.resource.data.expectedReach>=5&&request.resource.data.expectedReach<=100000;}
match /onTheMoveApplications/{id}{allow create:if validOTM(id);allow read,update,delete:if isSuperAdmin();}
function validSponsor(id){return request.resource.data.keys().hasAll(["enquiryId","contactName","organizationName","contactRole","email","phone","country","scope","message","declaration","status","source","createdAt","updatedAt"])&&request.resource.data.keys().hasOnly(["enquiryId","contactName","organizationName","contactRole","email","phone","country","scope","preferredArea","message","declaration","status","source","createdAt","updatedAt"])&&request.resource.data.enquiryId==id&&id.matches('SOMS-[0-9]{8}-[A-F0-9]{8}')&&request.resource.data.status=="new"&&request.resource.data.source=="on-the-move-sponsor-web"&&request.resource.data.declaration==true&&request.resource.data.contactName is string&&request.resource.data.contactName.size()>=2&&request.resource.data.contactName.size()<=120&&request.resource.data.organizationName is string&&request.resource.data.organizationName.size()>=2&&request.resource.data.organizationName.size()<=120&&request.resource.data.email is string&&request.resource.data.email.size()>=5&&request.resource.data.email.size()<=160&&request.resource.data.message is string&&request.resource.data.message.size()>=20&&request.resource.data.message.size()<=1500;}
match /onTheMoveSponsorEnquiries/{id}{allow create:if validSponsor(id);allow read,update,delete:if isSuperAdmin();}
match /{document=**}{allow read,write:if isSuperAdmin();}
}}