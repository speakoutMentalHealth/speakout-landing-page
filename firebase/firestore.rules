rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userExists() ? userDoc().data.role : "";
    }

    function userSchoolId() {
      return userExists() ? userDoc().data.schoolId : "";
    }

    /* Many existing accounts have no `approved` field at all (only
       `status`), so requiring it here rejected real accounts — including
       login itself. The app's own client code (auth.js) already treats
       status == "approved" as sufficient on its own; match that here. */
    function isApproved() {
      return userExists() &&
        userDoc().data.status == "approved";
    }

    function isSuperAdmin() {
      return isApproved() &&
        (userRole() == "super_admin" || userRole() == "admin");
    }

    function isSchoolAdmin() {
      return isApproved() && userRole() == "school_admin";
    }

    function isTeacher() {
      return isApproved() && userRole() == "teacher";
    }

    function isParent() {
      return isApproved() && userRole() == "parent";
    }

    function isStudent() {
      return isApproved() && userRole() == "student";
    }

    function isAmbassador() {
      return isApproved() && userRole() == "ambassador";
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;

      allow read: if isApproved() &&
        (
          request.auth.uid == userId ||
          isSuperAdmin() ||
          (
            isSchoolAdmin() &&
            resource.data.schoolId == userSchoolId()
          )
        );

      allow update: if isApproved() &&
        (
          request.auth.uid == userId ||
          isSuperAdmin() ||
          (
            isSchoolAdmin() &&
            resource.data.schoolId == userSchoolId()
          )
        );

      allow delete: if isSuperAdmin();
    }

    match /schools/{schoolId} {
      allow create: if isSignedIn();

      allow read: if isApproved() &&
        (
          isSuperAdmin() ||
          (
            isSchoolAdmin() &&
            userSchoolId() == schoolId
          ) ||
          (
            (isTeacher() || isParent() || isStudent()) &&
            userSchoolId() == schoolId
          )
        );

      allow update: if isSuperAdmin() ||
        (
          isSchoolAdmin() &&
          userSchoolId() == schoolId
        );

      allow delete: if isSuperAdmin();
    }

    match /parentStudentLinks/{linkId} {
      allow create: if isApproved() && (isParent() || isSchoolAdmin() || isSuperAdmin());

      allow read: if isApproved() &&
        (
          isSuperAdmin() ||
          isSchoolAdmin() ||
          resource.data.parentId == request.auth.uid ||
          resource.data.studentId == request.auth.uid
        );

      allow update, delete: if isSuperAdmin() || isSchoolAdmin();
    }

    match /books/{bookId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    match /parentResources/{resourceId} {
      allow read: if isApproved() && (isParent() || isSchoolAdmin() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /teacherResources/{resourceId} {
      allow read: if isApproved() && (isTeacher() || isSchoolAdmin() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /studentResources/{resourceId} {
      allow read: if isApproved() && (isStudent() || isTeacher() || isSchoolAdmin() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /schoolResources/{resourceId} {
      allow read: if isApproved() &&
        (
          isSuperAdmin() ||
          (
            resource.data.schoolId == userSchoolId() &&
            (isSchoolAdmin() || isTeacher() || isParent() || isStudent())
          )
        );

      allow write: if isSuperAdmin() ||
        (
          isSchoolAdmin() &&
          request.resource.data.schoolId == userSchoolId()
        );
    }

    match /workshops/{workshopId} {
      allow read: if isApproved() &&
        (
          isSuperAdmin() ||
          (
            resource.data.schoolId == userSchoolId() &&
            (isSchoolAdmin() || isTeacher() || isParent() || isStudent())
          )
        );

      allow create, update, delete: if isSuperAdmin() ||
        (
          isSchoolAdmin() &&
          request.resource.data.schoolId == userSchoolId()
        );
    }

    match /courses/{courseId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    match /courseModules/{moduleId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    match /courseLessons/{lessonId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    /* PRIVATE ANSWER KEYS.
       Cloud Functions Admin SDK bypasses these rules entirely.
       No browser/client may ever read or write this collection. */
    match /courseAssessments/{assessmentId} {
      allow read, write: if false;
    }

    /* TEMPORARY: left as the original permissive rules on purpose.
       course-player.html is currently running the old client-side-write
       version (Cloud Functions/billing not set up yet), which needs
       direct write access to these two collections. Once the secure
       Cloud Functions are deployed and course-player.html is switched
       back to calling them, tighten these back down to admin-only
       writes (see git history / DEPLOYMENT.md for the locked-down
       version) — do NOT deploy that version before the Functions are
       live, or quiz progress/certificates will silently stop saving. */
    match /userProgress/{progressId} {
      allow read, write: if isApproved() &&
        (
          resource.data.userId == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          isSuperAdmin()
        );
    }

    match /certificates/{certificateId} {
      allow read: if true;

      allow create: if isApproved() &&
        (
          isSuperAdmin() ||
          request.resource.data.userId == request.auth.uid
        );

      allow update, delete: if isSuperAdmin();
    }

    match /certificateTemplates/{templateId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    /* Learners submit proof of an externally-completed course here, and
       may resubmit after a rejection (external-learning-submit.html
       always writes status "pending_review" / verificationStatus
       "pending" on every submit — first-time or resubmit). That's the
       only state a learner's own write may ever set: they cannot write
       "approved" into their own record, so self-approval is impossible.
       Only Cloud Functions (reviewExternalCertificate) or an admin may
       move a record to "approved"/"rejected". */
    match /externalLearningRecords/{recordId} {
      allow create, update: if isApproved() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "pending_review" &&
        request.resource.data.verificationStatus == "pending";

      allow read: if isApproved() &&
        (
          resource.data.userId == request.auth.uid ||
          isSuperAdmin()
        );

      allow update, delete: if isSuperAdmin();
    }

    match /contributors/{contributorId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    match /contributorApplications/{applicationId} {
      allow create: if isSignedIn();

      allow read, update, delete: if isSuperAdmin();
    }

    match /kiddiesResources/{resourceId} {
      allow read: if isApproved() && (isStudent() || isParent() || isTeacher() || isSchoolAdmin() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /homepageMedia/{mediaId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /newsEvents/{eventId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow create: if isSignedIn();

      allow read: if isSuperAdmin() ||
        (
          isApproved() &&
          resource.data.userId == request.auth.uid
        );

      allow update, delete: if isSuperAdmin();
    }

    match /donations/{donationId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /schoolApplications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
