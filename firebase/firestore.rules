rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userExists() ? userDoc().data.role : "";
    }

    function userSchoolId() {
      return userExists() ? userDoc().data.schoolId : "";
    }

    function isApproved() {
      return userExists() &&
        userDoc().data.status == "approved";
    }

    function isSuperAdmin() {
      return isApproved() &&
        (userRole() == "super_admin" || userRole() == "admin");
    }

    function isSchoolAdmin() {
      return isApproved() && userRole() == "school_admin";
    }

    function isTeacher() {
      return isApproved() && userRole() == "teacher";
    }

    function isParent() {
      return isApproved() && userRole() == "parent";
    }

    function isStudent() {
      return isApproved() && userRole() == "student";
    }

    function isAmbassador() {
      return isApproved() && userRole() == "ambassador";
    }

    function isPublicRole(role) {
      return role in [
        "student", "parent", "teacher", "school", "school_admin",
        "ambassador", "contributor", "volunteer"
      ];
    }

    function validNewUser(userId) {
      return request.resource.data.keys().hasAll(["uid", "email", "role", "status", "approved"]) &&
        request.resource.data.uid == userId &&
        request.auth.uid == userId &&
        request.resource.data.status == "pending" &&
        request.resource.data.approved == false &&
        isPublicRole(request.resource.data.role) &&
        request.resource.data.email is string;
    }

    function onlyEditableProfileFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "firstName", "lastName", "fullName", "phone", "country", "state",
        "city", "location", "occupation", "bio", "photoURL",
        "profileCompleted", "updatedAt"
      ]);
    }

    function isUserInSchool(userId, schoolId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.schoolId == schoolId;
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId && validNewUser(userId);
      // A signed-in user may read only their own profile so the client can resolve
      // pending/rejected/suspended status and sign them out safely. All cross-user
      // reads still require canonical approval and the appropriate privileged role.
      allow read: if (isSignedIn() && request.auth.uid == userId) ||
        (isApproved() &&
          (isSuperAdmin() ||
            (isSchoolAdmin() && resource.data.schoolId == userSchoolId())));
      allow update: if isSuperAdmin() ||
        (isApproved() && request.auth.uid == userId &&
          onlyEditableProfileFieldsChanged());
      allow delete: if isSuperAdmin();
    }

    match /users/{userId}/academyDraftPractice/{lessonId} {
      allow read: if isApproved() && request.auth.uid == userId;
      allow create, update: if isApproved() && request.auth.uid == userId &&
        lessonId.size() > 0 && lessonId.size() <= 80 &&
        request.resource.data.keys().hasOnly(['lessonId','score','total','updatedAt','kind']) &&
        request.resource.data.keys().hasAll(['lessonId','score','total','updatedAt','kind']) &&
        request.resource.data.lessonId == lessonId &&
        request.resource.data.kind == 'unreviewed-draft-practice' &&
        request.resource.data.score is int && request.resource.data.total is int &&
        request.resource.data.total >= 1 && request.resource.data.total <= 50 &&
        request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /schools/{schoolId} {
      allow create: if isSuperAdmin();
      allow read: if isApproved() &&
        (isSuperAdmin() || (isSchoolAdmin() && userSchoolId() == schoolId) ||
          ((isTeacher() || isParent() || isStudent()) && userSchoolId() == schoolId));
      allow update: if isSuperAdmin() || (isSchoolAdmin() && userSchoolId() == schoolId);
      allow delete: if isSuperAdmin();
    }

    match /parentStudentLinks/{linkId} {
      allow create: if isSuperAdmin() ||
        (isApproved() && request.resource.data.schoolId == userSchoolId() &&
          isUserInSchool(request.resource.data.studentId, userSchoolId()) &&
          ((isSchoolAdmin() && isUserInSchool(request.resource.data.parentId, userSchoolId())) ||
            (isParent() && request.resource.data.parentId == request.auth.uid)));
      allow read: if isApproved() &&
        (isSuperAdmin() || (isSchoolAdmin() && resource.data.schoolId == userSchoolId()) ||
          resource.data.parentId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow update: if isSuperAdmin() ||
        (isSchoolAdmin() && resource.data.schoolId == userSchoolId() &&
          request.resource.data.schoolId == userSchoolId() &&
          request.resource.data.parentId == resource.data.parentId &&
          request.resource.data.studentId == resource.data.studentId);
      allow delete: if isSuperAdmin() ||
        (isSchoolAdmin() && resource.data.schoolId == userSchoolId());
    }

    // Learning preferences personalise a catalogue; they never approve an
    // account, change a school record or grant access to private school data.
    match /learningPreferences/{userId} {
      function validLearningPreference() {
        let value = request.resource.data;
        return value.keys().hasOnly(["educationStage", "classLevel", "updatedAt"]) &&
          value.keys().hasAll(["educationStage", "classLevel", "updatedAt"]) &&
          value.updatedAt == request.time &&
          ((value.educationStage == "nursery" && value.classLevel in ["Nursery 1", "Nursery 2", "Nursery 3"]) ||
           (value.educationStage == "primary" && value.classLevel in ["Primary 1", "Primary 2", "Primary 3", "Primary 4", "Primary 5", "Primary 6"]) ||
           (value.educationStage == "secondary" && value.classLevel in ["JSS 1", "JSS 2", "JSS 3", "SS 1", "SS 2", "SS 3"]) ||
           (value.educationStage == "tertiary" && value.classLevel in ["100 Level", "200 Level", "300 Level", "400 Level", "500 Level", "600 Level", "ND 1", "ND 2", "HND 1", "HND 2", "NCE 1", "NCE 2", "NCE 3", "Postgraduate"]));
      }
      allow read: if isApproved() && request.auth.uid == userId;
      allow create, update: if isStudent() && request.auth.uid == userId &&
        userDoc().data.get("schoolId", "") == "" &&
        userDoc().data.get("schoolCode", "") == "" && validLearningPreference();
      allow delete: if isApproved() && request.auth.uid == userId;
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /bookSubmissions/{submissionId} {
      allow create: if isSignedIn() &&
        request.resource.data.submittedBy == request.auth.uid &&
        request.resource.data.status == "pending";
      allow read: if isSignedIn() &&
        (resource.data.submittedBy == request.auth.uid || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    match /parentResources/{resourceId} {
      allow read: if isApproved() && (isParent() || isSchoolAdmin() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /teacherResources/{resourceId} {
      allow read: if isApproved() && (isTeacher() || isSchoolAdmin() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /studentResources/{resourceId} {
      allow read: if isApproved() && (isStudent() || isTeacher() || isSchoolAdmin() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /schoolResources/{resourceId} {
      allow read: if isApproved() &&
        (isSuperAdmin() || (resource.data.schoolId == userSchoolId() &&
          (isSchoolAdmin() || isTeacher() || isParent() || isStudent())));
      allow create: if isSuperAdmin() ||
        (isSchoolAdmin() && request.resource.data.schoolId == userSchoolId());
      allow update: if isSuperAdmin() ||
        (isSchoolAdmin() && resource.data.schoolId == userSchoolId() &&
          request.resource.data.schoolId == userSchoolId());
      allow delete: if isSuperAdmin() ||
        (isSchoolAdmin() && resource.data.schoolId == userSchoolId());
    }

    match /workshops/{workshopId} {
      allow read: if isApproved() &&
        (isSuperAdmin() || (resource.data.schoolId == userSchoolId() &&
          (isSchoolAdmin() || isTeacher() || isParent() || isStudent())));
      allow create: if isSuperAdmin() ||
        (isSchoolAdmin() && request.resource.data.schoolId == userSchoolId());
      allow update: if isSuperAdmin() ||
        (isSchoolAdmin() && resource.data.schoolId == userSchoolId() &&
          request.resource.data.schoolId == userSchoolId());
      allow delete: if isSuperAdmin() ||
        (isSchoolAdmin() && resource.data.schoolId == userSchoolId());
    }


    function programmeData(programmeId) {
      return get(/databases/$(database)/documents/programmes/$(programmeId)).data;
    }

    function programmeExists(programmeId) {
      return exists(/databases/$(database)/documents/programmes/$(programmeId));
    }

    function sameProgrammeSchool(programmeId) {
      return programmeExists(programmeId) &&
        programmeData(programmeId).schoolId == userSchoolId();
    }

    function isProgrammeFacilitator(programmeId) {
      return isTeacher() &&
        sameProgrammeSchool(programmeId) &&
        (
          programmeData(programmeId).createdBy == request.auth.uid ||
          (
            programmeData(programmeId).keys().hasAny(["facilitatorIds"]) &&
            request.auth.uid in programmeData(programmeId).facilitatorIds
          )
        );
    }

    function isProgrammeMember(programmeId) {
      return isStudent() &&
        exists(/databases/$(database)/documents/programmeMemberships/$(programmeId + "__" + request.auth.uid)) &&
        get(/databases/$(database)/documents/programmeMemberships/$(programmeId + "__" + request.auth.uid)).data.status == "active";
    }

    function canManageProgramme(programmeId) {
      return isSuperAdmin() ||
        (isSchoolAdmin() && sameProgrammeSchool(programmeId)) ||
        isProgrammeFacilitator(programmeId);
    }

    function studentBelongsToProgrammeSchool(programmeId, studentId) {
      return sameProgrammeSchool(programmeId) &&
        isUserInSchool(studentId, userSchoolId()) &&
        get(/databases/$(database)/documents/users/$(studentId)).data.role == "student";
    }

    function programmeMembershipExists(programmeId, studentId) {
      return exists(/databases/$(database)/documents/programmeMemberships/$(programmeId + "__" + studentId)) &&
        get(/databases/$(database)/documents/programmeMemberships/$(programmeId + "__" + studentId)).data.status == "active";
    }

    function sessionBelongsToProgramme(sessionId, programmeId) {
      return exists(/databases/$(database)/documents/programmeSessions/$(sessionId)) &&
        get(/databases/$(database)/documents/programmeSessions/$(sessionId)).data.programmeId == programmeId;
    }

    function assignmentBelongsToProgramme(assignmentId, programmeId) {
      return exists(/databases/$(database)/documents/programmeAssignments/$(assignmentId)) &&
        get(/databases/$(database)/documents/programmeAssignments/$(assignmentId)).data.programmeId == programmeId;
    }

    match /programmes/{programmeId} {
      allow create: if isSuperAdmin() ||
        (
          isSchoolAdmin() &&
          request.resource.data.schoolId == userSchoolId()
        ) ||
        (
          isTeacher() &&
          request.resource.data.schoolId == userSchoolId() &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.status == "pending_approval" &&
          request.resource.data.facilitatorIds is list &&
          request.auth.uid in request.resource.data.facilitatorIds
        );

      allow read: if isApproved() &&
        (
          isSuperAdmin() ||
          (
            resource.data.schoolId == userSchoolId() &&
            (
              isSchoolAdmin() ||
              isTeacher() ||
              (isStudent() && resource.data.status == "active")
            )
          )
        );

      allow update: if isSuperAdmin() ||
        (
          isSchoolAdmin() &&
          resource.data.schoolId == userSchoolId() &&
          request.resource.data.schoolId == userSchoolId()
        ) ||
        (
          isProgrammeFacilitator(programmeId) &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.facilitatorIds == resource.data.facilitatorIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name", "type", "category", "source", "description", "objectives",
            "expectedOutcomes", "scheduleDay", "scheduleTime", "frequency",
            "venue", "membershipMode", "parentVisibility", "updatedAt"
          ])
        );

      allow delete: if isSuperAdmin() ||
        (
          isSchoolAdmin() &&
          resource.data.schoolId == userSchoolId()
        ) ||
        (
          isTeacher() &&
          resource.data.schoolId == userSchoolId() &&
          resource.data.createdBy == request.auth.uid &&
          resource.data.status in ["draft", "pending_approval"]
        );
    }

    match /programmeMemberships/{membershipId} {
      allow read: if isApproved() &&
        (
          isSuperAdmin() ||
          (isSchoolAdmin() && resource.data.schoolId == userSchoolId()) ||
          isProgrammeFacilitator(resource.data.programmeId) ||
          (isStudent() && resource.data.userId == request.auth.uid)
        );

      allow create: if
        membershipId == request.resource.data.programmeId + "__" + request.resource.data.userId &&
        (
          isSuperAdmin() ||
          (
            isSchoolAdmin() &&
            request.resource.data.schoolId == userSchoolId() &&
            studentBelongsToProgrammeSchool(request.resource.data.programmeId, request.resource.data.userId)
          ) ||
          (
            isProgrammeFacilitator(request.resource.data.programmeId) &&
            request.resource.data.schoolId == userSchoolId() &&
            studentBelongsToProgrammeSchool(request.resource.data.programmeId, request.resource.data.userId)
          ) ||
          (
            isStudent() &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.schoolId == userSchoolId() &&
            sameProgrammeSchool(request.resource.data.programmeId) &&
            programmeData(request.resource.data.programmeId).status == "active" &&
            programmeData(request.resource.data.programmeId).membershipMode in ["open", "voluntary"] &&
            request.resource.data.status == "active"
          )
        );

      allow update: if isSuperAdmin() ||
        (
          isSchoolAdmin() &&
          resource.data.schoolId == userSchoolId() &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.programmeId == resource.data.programmeId
        ) ||
        (
          isProgrammeFacilitator(resource.data.programmeId) &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.programmeId == resource.data.programmeId
        );

      allow delete: if isSuperAdmin() ||
        (isSchoolAdmin() && resource.data.schoolId == userSchoolId()) ||
        isProgrammeFacilitator(resource.data.programmeId);
    }

    match /programmeSessions/{sessionId} {
      allow read: if isApproved() &&
        (
          canManageProgramme(resource.data.programmeId) ||
          isProgrammeMember(resource.data.programmeId)
        );
      allow create: if isApproved() &&
        canManageProgramme(request.resource.data.programmeId) &&
        request.resource.data.schoolId == userSchoolId();
      allow update: if isApproved() &&
        canManageProgramme(resource.data.programmeId) &&
        request.resource.data.programmeId == resource.data.programmeId &&
        request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if isApproved() && canManageProgramme(resource.data.programmeId);
    }

    match /programmeAttendance/{attendanceId} {
      allow read: if isApproved() &&
        (
          canManageProgramme(resource.data.programmeId) ||
          (isStudent() && resource.data.studentId == request.auth.uid)
        );
      allow create: if isApproved() &&
        attendanceId == request.resource.data.sessionId + "__" + request.resource.data.studentId &&
        canManageProgramme(request.resource.data.programmeId) &&
        request.resource.data.schoolId == userSchoolId() &&
        sessionBelongsToProgramme(request.resource.data.sessionId, request.resource.data.programmeId) &&
        studentBelongsToProgrammeSchool(request.resource.data.programmeId, request.resource.data.studentId);
      allow update: if isApproved() &&
        canManageProgramme(resource.data.programmeId) &&
        request.resource.data.programmeId == resource.data.programmeId &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.studentId == resource.data.studentId;
      allow delete: if isApproved() && canManageProgramme(resource.data.programmeId);
    }

    match /programmeAssignments/{assignmentId} {
      allow read: if isApproved() &&
        (
          canManageProgramme(resource.data.programmeId) ||
          isProgrammeMember(resource.data.programmeId)
        );
      allow create: if isApproved() &&
        canManageProgramme(request.resource.data.programmeId) &&
        request.resource.data.schoolId == userSchoolId();
      allow update: if isApproved() &&
        canManageProgramme(resource.data.programmeId) &&
        request.resource.data.programmeId == resource.data.programmeId &&
        request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if isApproved() && canManageProgramme(resource.data.programmeId);
    }

    match /programmeSubmissions/{submissionId} {
      allow read: if isApproved() &&
        (
          canManageProgramme(resource.data.programmeId) ||
          (isStudent() && resource.data.studentId == request.auth.uid)
        );

      allow create: if isApproved() &&
        submissionId == request.resource.data.assignmentId + "__" + request.resource.data.studentId &&
        assignmentBelongsToProgramme(request.resource.data.assignmentId, request.resource.data.programmeId) &&
        (
          (
            isStudent() &&
            request.resource.data.studentId == request.auth.uid &&
            request.resource.data.submittedBy == request.auth.uid &&
            request.resource.data.submittedOnBehalf == false &&
            isProgrammeMember(request.resource.data.programmeId) &&
            request.resource.data.status == "submitted" &&
            request.resource.data.feedback == "" &&
            request.resource.data.reviewedBy == ""
          ) ||
          (
            canManageProgramme(request.resource.data.programmeId) &&
            request.resource.data.schoolId == userSchoolId() &&
            request.resource.data.submittedOnBehalf == true &&
            request.resource.data.submittedBy == request.auth.uid &&
            studentBelongsToProgrammeSchool(request.resource.data.programmeId, request.resource.data.studentId) &&
            programmeMembershipExists(request.resource.data.programmeId, request.resource.data.studentId)
          )
        );

      allow update: if isApproved() &&
        (
          (
            canManageProgramme(resource.data.programmeId) &&
            request.resource.data.programmeId == resource.data.programmeId &&
            request.resource.data.assignmentId == resource.data.assignmentId &&
            request.resource.data.studentId == resource.data.studentId &&
            request.resource.data.schoolId == resource.data.schoolId
          ) ||
          (
            isStudent() &&
            resource.data.studentId == request.auth.uid &&
            request.resource.data.studentId == request.auth.uid &&
            request.resource.data.programmeId == resource.data.programmeId &&
            request.resource.data.assignmentId == resource.data.assignmentId &&
            request.resource.data.schoolId == resource.data.schoolId &&
            request.resource.data.submittedBy == request.auth.uid &&
            request.resource.data.submittedOnBehalf == false &&
            request.resource.data.status == "submitted" &&
            request.resource.data.feedback == "" &&
            request.resource.data.reviewedBy == "" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "submissionMethod", "responseText", "evidenceUrl", "status",
              "feedback", "reviewedBy", "reviewedAt", "submittedAt", "updatedAt"
            ])
          )
        );

      allow delete: if isSuperAdmin() ||
        (isSchoolAdmin() && resource.data.schoolId == userSchoolId());
    }

    match /courses/{courseId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    match /courseModules/{moduleId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    match /courseLessons/{lessonId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    match /courseAssessments/{assessmentId} {
      allow read, write: if false;
    }

    match /userProgress/{progressId} {
      allow read: if isApproved() &&
        (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /readingProgress/{progressId} {
      allow read: if isApproved() && resource.data.userId == request.auth.uid;
      allow create: if isApproved() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type in ["book", "kiddies"];
      allow update: if isApproved() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type in ["book", "kiddies"];
      allow delete: if isApproved() && resource.data.userId == request.auth.uid;
    }

    match /certificates/{certificateId} {
      allow read: if isSuperAdmin() ||
        (isApproved() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isSuperAdmin();
    }

    match /publicCertificateVerifications/{verificationCode} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /certificateTemplates/{templateId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    // Academic records are sensitive school records. All access is mediated by
    // the authenticated Platform API so fee clearance, parent links, PIN state,
    // versioning, rate limits and audit logging cannot be bypassed by clients.
    match /academicResults/{resultId} {
      allow read, write: if false;
    }

    match /academicResultUnlocks/{unlockId} {
      allow read, write: if false;
    }

    match /academicResultPinAttempts/{attemptId} {
      allow read, write: if false;
    }

    match /academicResultAuditLogs/{auditId} {
      allow read, write: if false;
    }

    match /externalCredentials/{credentialId} {
      // Manual provider credentials are authoritative verification records.
      // All learner/admin access is mediated by the authenticated Platform API.
      allow read, write: if false;
    }

    match /externalLearningRecords/{recordId} {
      allow read: if isApproved() &&
        (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create, update, delete: if isSuperAdmin();
    }

    match /contributors/{contributorId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    match /contributorApplications/{applicationId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSuperAdmin();
    }

    match /kiddiesResources/{resourceId} {
      allow read: if isApproved() &&
        (isStudent() || isParent() || isTeacher() || isSchoolAdmin() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /homepageMedia/{mediaId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /tvEpisodes/{episodeId} {
      allow read: if resource.data.status == "active" || resource.data.status == "published" || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /tvAudio/{audioId} {
      allow read: if resource.data.status == "active" || resource.data.status == "published" || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /tvShows/{showId} {
      allow read: if resource.data.status == "active" || resource.data.status == "published" || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /tvCuratorSources/{sourceId} {
      allow read, write: if isSuperAdmin();
    }

    match /tvCuratorCandidates/{candidateId} {
      allow read, write: if isSuperAdmin();
    }

    match /newsEvents/{eventId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow create: if isApproved() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "pending";
      allow read: if isSuperAdmin() ||
        (isApproved() && resource.data.userId == request.auth.uid);
      allow update, delete: if isSuperAdmin();
    }

    match /donations/{donationId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /schoolApplications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    function validOTM(applicationId) {
      return request.resource.data.keys().hasAll([
          "applicationId", "organizationName", "organizationType", "country", "state", "city",
          "contactName", "contactRole", "email", "phone", "program", "audience", "ageRange",
          "expectedReach", "reason", "needs", "venue", "logistics", "funding", "clubInterest",
          "partnershipInterest", "declaration", "status", "source", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "applicationId", "organizationName", "organizationType", "website", "country", "state", "city",
          "contactName", "contactRole", "email", "phone", "program", "audience", "ageRange",
          "expectedReach", "reason", "needs", "preferredDate", "alternativeDate", "venue", "logistics",
          "facilities", "funding", "clubInterest", "partnershipInterest", "declaration", "status", "source",
          "createdAt", "updatedAt"
        ]) &&
        request.resource.data.applicationId == applicationId &&
        applicationId.matches('SOM-[0-9]{8}-[A-F0-9]{8}') &&
        request.resource.data.status == "new" &&
        request.resource.data.source == "on-the-move-web" &&
        request.resource.data.declaration == true &&
        request.resource.data.organizationName is string &&
        request.resource.data.organizationName.size() >= 2 && request.resource.data.organizationName.size() <= 120 &&
        request.resource.data.email is string && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 160 &&
        request.resource.data.phone is string && request.resource.data.phone.size() >= 5 && request.resource.data.phone.size() <= 40 &&
        request.resource.data.reason is string && request.resource.data.reason.size() >= 30 && request.resource.data.reason.size() <= 1500 &&
        request.resource.data.needs is string && request.resource.data.needs.size() >= 20 && request.resource.data.needs.size() <= 1500 &&
        request.resource.data.expectedReach is number && request.resource.data.expectedReach >= 5 && request.resource.data.expectedReach <= 100000;
    }

    match /onTheMoveApplications/{applicationId} {
      allow create: if validOTM(applicationId);
      allow read: if isSuperAdmin();
      allow delete: if isSuperAdmin() && !resource.data.keys().hasAny(["communicationHistory", "lastCommunicationAt"]);
      allow update: if isSuperAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["communicationHistory", "lastCommunicationAt"]);
    }

    function validSponsor(enquiryId) {
      return request.resource.data.keys().hasAll([
          "enquiryId", "contactName", "organizationName", "contactRole", "email", "phone", "country",
          "scope", "message", "declaration", "status", "source", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "enquiryId", "contactName", "organizationName", "contactRole", "email", "phone", "country",
          "scope", "preferredArea", "message", "declaration", "status", "source", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.enquiryId == enquiryId &&
        enquiryId.matches('SOMS-[0-9]{8}-[A-F0-9]{8}') &&
        request.resource.data.status == "new" &&
        request.resource.data.source == "on-the-move-sponsor-web" &&
        request.resource.data.declaration == true &&
        request.resource.data.contactName is string && request.resource.data.contactName.size() >= 2 && request.resource.data.contactName.size() <= 120 &&
        request.resource.data.organizationName is string && request.resource.data.organizationName.size() >= 2 && request.resource.data.organizationName.size() <= 120 &&
        request.resource.data.email is string && request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 160 &&
        request.resource.data.message is string && request.resource.data.message.size() >= 20 && request.resource.data.message.size() <= 1500;
    }

    match /onTheMoveSponsorEnquiries/{enquiryId} {
      allow create: if validSponsor(enquiryId);
      allow read: if isSuperAdmin();
      allow delete: if isSuperAdmin() && !resource.data.keys().hasAny(["communicationHistory", "lastCommunicationAt"]);
      allow update: if isSuperAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["communicationHistory", "lastCommunicationAt"]);
    }

    // Reviewer applications are immutable, owner-readable requests only.
    // Approval, public attribution and creator monetization are never client-granted.
    match /homeLearningReviewerApplications/{applicantUid} {
      allow read: if isSuperAdmin() ||
        (isSignedIn() && request.auth.uid == applicantUid);
      allow create: if isTeacher() && request.auth.uid == applicantUid &&
        request.resource.data.keys().hasOnly([
          "applicantUid", "displayName", "subjectExpertise", "experience",
          "consentToContact", "publicCreditOptIn", "status", "submittedAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "applicantUid", "displayName", "subjectExpertise", "experience",
          "consentToContact", "publicCreditOptIn", "status", "submittedAt"
        ]) &&
        request.resource.data.applicantUid == applicantUid &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 2 &&
        request.resource.data.displayName.size() <= 100 &&
        request.resource.data.subjectExpertise is string &&
        request.resource.data.subjectExpertise.size() >= 3 &&
        request.resource.data.subjectExpertise.size() <= 180 &&
        request.resource.data.experience is string &&
        request.resource.data.experience.size() >= 20 &&
        request.resource.data.experience.size() <= 1500 &&
        request.resource.data.consentToContact == true &&
        request.resource.data.publicCreditOptIn is bool &&
        request.resource.data.status == "pending_review" &&
        request.resource.data.submittedAt == request.time;
      allow update, delete: if false;
    }

    // Home Learning educator reviews: assignment is administrator-managed.
    // Client review submissions are immutable recommendations, never approvals.
    function isHomeLearningReviewCollection(collection) {
      return collection in ["homeLearningReviewerAssignments", "homeLearningReviewSubmissions", "homeLearningEditorialApprovals", "homeLearningReviewerApplications", "homeLearningTrustedResourceManifests", "homeLearningManifestCandidates"];
    }

    match /homeLearningReviewerAssignments/{assignmentId} {
      allow read: if isSuperAdmin() ||
        (isTeacher() && resource.data.reviewerUid == request.auth.uid);
      allow create: if isSuperAdmin() &&
        request.resource.data.keys().hasOnly(["reviewerUid", "resourceId", "resourceVersion", "assignedAt"]) &&
        request.resource.data.keys().hasAll(["reviewerUid", "resourceId", "resourceVersion", "assignedAt"]) &&
        request.resource.data.reviewerUid is string &&
        request.resource.data.reviewerUid.size() > 0 &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.reviewerUid)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.reviewerUid)).data.role == "teacher" &&
        get(/databases/$(database)/documents/users/$(request.resource.data.reviewerUid)).data.status == "approved" &&
        request.resource.data.resourceId is string &&
        request.resource.data.resourceId.size() > 0 &&
        request.resource.data.resourceVersion is string &&
        request.resource.data.resourceVersion.size() >= 1 &&
        request.resource.data.resourceVersion.size() <= 120 &&
        request.resource.data.assignedAt == request.time;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /homeLearningReviewSubmissions/{submissionId} {
      allow read: if isSuperAdmin() ||
        (isTeacher() && resource.data.reviewerUid == request.auth.uid);
      allow create: if isTeacher() &&
        exists(/databases/$(database)/documents/homeLearningReviewerAssignments/$(submissionId)) &&
        get(/databases/$(database)/documents/homeLearningReviewerAssignments/$(submissionId)).data.reviewerUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(["reviewerUid", "resourceId", "resourceVersion", "reviewStatus", "findings", "submittedAt"]) &&
        request.resource.data.keys().hasAll(["reviewerUid", "resourceId", "resourceVersion", "reviewStatus", "findings", "submittedAt"]) &&
        request.resource.data.reviewerUid == request.auth.uid &&
        request.resource.data.resourceId ==
          get(/databases/$(database)/documents/homeLearningReviewerAssignments/$(submissionId)).data.resourceId &&
        request.resource.data.resourceVersion ==
          get(/databases/$(database)/documents/homeLearningReviewerAssignments/$(submissionId)).data.resourceVersion &&
        request.resource.data.reviewStatus == "submitted_for_verification" &&
        request.resource.data.findings is string &&
        request.resource.data.findings.size() >= 10 &&
        request.resource.data.findings.size() <= 4000 &&
        request.resource.data.submittedAt == request.time;
      allow update, delete: if false;
    }

    // Trusted resource manifests must be written only by an audited backend.
    // A browser administrator must not be able to substitute content hashes.
    match /homeLearningTrustedResourceManifests/{manifestId} {
      allow read, create, update, delete: if false;
    }

    // Candidate digests are backend-only too, including for super admins.
    match /homeLearningManifestCandidates/{candidateId} {
      allow read, create, update, delete: if false;
    }

    // Approval authority is deliberately server-only. Admin SDK bypasses
    // client rules and must enforce signed-off reviews, content hashes,
    // independent authorization and audit retention before writing here.
    match /homeLearningEditorialApprovals/{approvalId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }


    // Pilot control is only provisioned by a trusted Firebase administrative process.
    function forumPilotGateIsActive(roomId) {
      let gate = get(/databases/$(database)/documents/forumReleaseControls/pilot).data;
      return gate.enabled == true && gate.mode == "private_pilot" &&
        gate.expiresAt is timestamp && gate.expiresAt > request.time &&
        gate.roomIds is list && roomId in gate.roomIds;
    }
    function forumPilotAuthorized(roomId) {
      return exists(/databases/$(database)/documents/forumReleaseControls/pilot) &&
        forumPilotGateIsActive(roomId);
    }
    function forumPilotWriteAllowed(roomId) {
      return request.resource.data.published == false ||
        (request.resource.data.published == true &&
         resource.data.visibility == "private" &&
         request.resource.data.visibility == "private" &&
         request.resource.data.status in ["open", "read_only"] &&
         forumPilotAuthorized(roomId));
    }
    match /forumReleaseControls/{releaseId} {
      allow get: if isSuperAdmin();
      allow list, create, update, delete: if false;
    }
    match /forumReleaseControlAudits/{eventId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    // Trusted and expiring private pilot authorization is required to publish.
    function forumRoomValid() {
      let r = request.resource.data;
      return r.keys().hasOnly(["title", "description", "visibility", "status", "published", "createdAt", "updatedAt", "updatedBy", "version", "auditId"]) &&
        r.keys().hasAll(["title", "description", "visibility", "status", "published", "createdAt", "updatedAt", "updatedBy", "version", "auditId"]) &&
        r.title is string && r.title.size() >= 3 && r.title.size() <= 80 &&
        r.description is string && r.description.size() <= 240 &&
        r.visibility in ["public", "members_only", "private"] &&
        r.status in ["open", "read_only", "locked"] &&
        (r.published == false || r.published == true) &&
        r.createdAt is timestamp && r.updatedAt == request.time &&
        r.updatedBy == request.auth.uid &&
        r.version is int && r.version >= 1 && r.version <= 100000 &&
        r.auditId is string && r.auditId.size() >= 10 && r.auditId.size() <= 128;
    }

    function forumAuditPaired(roomId, previousVisibility, previousStatus, previousPublished) {
      let r = request.resource.data;
      let path = /databases/$(database)/documents/forumRoomAudits/$(r.auditId);
      return !exists(path) &&
        getAfter(path).data.roomId == roomId &&
        getAfter(path).data.actorUid == request.auth.uid &&
        getAfter(path).data.previousVisibility == previousVisibility &&
        getAfter(path).data.previousStatus == previousStatus &&
        getAfter(path).data.previousPublished == previousPublished &&
        getAfter(path).data.nextPublished == r.published &&
        getAfter(path).data.nextVisibility == r.visibility &&
        getAfter(path).data.nextStatus == r.status &&
        getAfter(path).data.revision == r.version &&
        getAfter(path).data.changedAt == request.time;
    }

    match /forumRooms/{roomId} {
      allow get: if forumMayReadRoom(roomId);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        roomId.matches("^[a-z][a-z0-9-]{2,55}$") &&
        forumRoomValid() && request.resource.data.published == false && request.resource.data.createdAt == request.time &&
        request.resource.data.version == 1 &&
        forumAuditPaired(roomId, "none", "none", false);
      allow update: if isSuperAdmin() && forumRoomValid() &&
        forumPilotWriteAllowed(roomId) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.version == resource.data.version + 1 &&
        request.resource.data.auditId != resource.data.auditId &&
        forumAuditPaired(roomId, resource.data.visibility, resource.data.status, resource.data.published);
      allow delete: if false;
    }

    match /forumRoomAudits/{auditId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        request.resource.data.keys().hasOnly(["roomId", "actorUid", "previousVisibility", "nextVisibility", "previousStatus", "nextStatus", "previousPublished", "nextPublished", "revision", "reason", "changedAt"]) &&
        request.resource.data.keys().hasAll(["roomId", "actorUid", "previousVisibility", "nextVisibility", "previousStatus", "nextStatus", "previousPublished", "nextPublished", "revision", "reason", "changedAt"]) &&
        request.resource.data.roomId is string &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.previousVisibility in ["none", "public", "members_only", "private"] &&
        request.resource.data.nextVisibility in ["public", "members_only", "private"] &&
        request.resource.data.previousStatus in ["none", "open", "read_only", "locked"] &&
        request.resource.data.nextStatus in ["open", "read_only", "locked"] &&
        request.resource.data.previousPublished is bool && request.resource.data.nextPublished is bool &&
        request.resource.data.revision is int &&
        request.resource.data.reason is string && request.resource.data.reason.size() >= 8 && request.resource.data.reason.size() <= 160 &&
        request.resource.data.changedAt == request.time &&
        getAfter(/databases/$(database)/documents/forumRooms/$(request.resource.data.roomId)).data.auditId == auditId &&
        getAfter(/databases/$(database)/documents/forumRooms/$(request.resource.data.roomId)).data.version == request.resource.data.revision &&
        getAfter(/databases/$(database)/documents/forumRooms/$(request.resource.data.roomId)).data.visibility == request.resource.data.nextVisibility &&
        getAfter(/databases/$(database)/documents/forumRooms/$(request.resource.data.roomId)).data.status == request.resource.data.nextStatus &&
        getAfter(/databases/$(database)/documents/forumRooms/$(request.resource.data.roomId)).data.published == request.resource.data.nextPublished;
      allow update, delete: if false;
    }

    // Phase 2: adult-verified membership and moderated conversations.
    // The publication flag remains false for all room client writes above.
    // This code prepares access policy for a future separately authorized release.
    function forumGrantPath(uid) {
      return /databases/$(database)/documents/forumAccessGrants/$(uid);
    }
    function forumGrant() {
      return get(forumGrantPath(request.auth.uid)).data;
    }
    function forumApprovedAdult() {
      return isApproved() && userRole() != "student" &&
        exists(forumGrantPath(request.auth.uid)) &&
        forumGrant().active == true &&
        forumGrant().adultVerified == true;
    }
    function forumModerator(roomId) {
      return forumApprovedAdult() && forumGrant().memberRole == "moderator" &&
        roomId in forumGrant().moderatedRoomIds;
    }
    function forumRoomPath(roomId) {
      return /databases/$(database)/documents/forumRooms/$(roomId);
    }
    function forumPrivateMember(roomId) {
      return forumApprovedAdult() && roomId in forumGrant().privateRoomIds;
    }
    function forumLivePrivateRoom(roomId) {
      let room = get(forumRoomPath(roomId)).data;
      return forumPilotAuthorized(roomId) &&
        room.published == true &&
        room.status != "locked" &&
        room.visibility == "private";
    }
    function forumMayReadRoom(roomId) {
      return isSuperAdmin() ||
        (forumApprovedAdult() && forumLivePrivateRoom(roomId) &&
          (roomId in forumGrant().privateRoomIds ||
            (forumGrant().memberRole == "moderator" && roomId in forumGrant().moderatedRoomIds)));
    }
    function forumMayModerate(roomId) {
      return forumModerator(roomId) && forumLivePrivateRoom(roomId);
    }
    function forumCanPost(roomId) {
      return forumApprovedAdult() && forumMayReadRoom(roomId) &&
        get(forumRoomPath(roomId)).data.published == true &&
        get(forumRoomPath(roomId)).data.status == "open";
    }
    function validForumGrant(uid) {
      let g = request.resource.data;
      return g.keys().hasOnly([
        "uid", "active", "adultVerified", "memberRole", "privateRoomIds",
        "moderatedRoomIds", "createdAt", "reviewedAt", "reviewedBy",
        "version", "auditId", "reason"
      ]) && g.keys().hasAll([
        "uid", "active", "adultVerified", "memberRole", "privateRoomIds",
        "moderatedRoomIds", "createdAt", "reviewedAt", "reviewedBy",
        "version", "auditId", "reason"
      ]) &&
      g.uid == uid && uid.size() >= 5 && uid.size() <= 128 &&
      exists(/databases/$(database)/documents/users/$(uid)) &&
      get(/databases/$(database)/documents/users/$(uid)).data.status == "approved" &&
      get(/databases/$(database)/documents/users/$(uid)).data.role != "student" &&
      g.active is bool && g.adultVerified == true &&
      g.memberRole in ["member", "moderator"] &&
      g.privateRoomIds is list && g.privateRoomIds.size() <= 20 &&
      g.moderatedRoomIds is list && g.moderatedRoomIds.size() <= 20 &&
      g.createdAt is timestamp && g.reviewedAt == request.time &&
      g.reviewedBy == request.auth.uid &&
      g.version is int && g.version >= 1 && g.version <= 100000 &&
      g.auditId is string && g.auditId.size() >= 10 && g.auditId.size() <= 128 &&
      g.reason is string && g.reason.size() >= 8 && g.reason.size() <= 160;
    }
    function pairedForumGrantAudit(uid, oldActive) {
      let g = request.resource.data;
      let path = /databases/$(database)/documents/forumGrantAudits/$(g.auditId);
      return !exists(path) &&
        getAfter(path).data.uid == uid &&
        getAfter(path).data.actorUid == request.auth.uid &&
        getAfter(path).data.previousActive == oldActive &&
        getAfter(path).data.nextActive == g.active &&
        getAfter(path).data.version == g.version &&
        getAfter(path).data.changedAt == request.time;
    }
    match /forumAccessGrants/{uid} {
      allow get: if isSuperAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() && validForumGrant(uid) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.version == 1 &&
        pairedForumGrantAudit(uid, false);
      allow update: if isSuperAdmin() && validForumGrant(uid) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.version == resource.data.version + 1 &&
        request.resource.data.auditId != resource.data.auditId &&
        pairedForumGrantAudit(uid, resource.data.active);
      allow delete: if false;
    }
    match /forumGrantAudits/{eventId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        request.resource.data.keys().hasOnly([
          "uid", "actorUid", "previousActive", "nextActive", "version", "changedAt", "reason"
        ]) && request.resource.data.keys().hasAll([
          "uid", "actorUid", "previousActive", "nextActive", "version", "changedAt", "reason"
        ]) &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.previousActive is bool &&
        request.resource.data.nextActive is bool &&
        request.resource.data.version is int &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 8 &&
        request.resource.data.reason.size() <= 160 &&
        request.resource.data.changedAt == request.time &&
        getAfter(forumGrantPath(request.resource.data.uid)).data.auditId == eventId &&
        getAfter(forumGrantPath(request.resource.data.uid)).data.active == request.resource.data.nextActive &&
        getAfter(forumGrantPath(request.resource.data.uid)).data.version == request.resource.data.version;
      allow update, delete: if false;
    }

    function validForumContribution(kind) {
      let c = request.resource.data;
      return c.keys().hasOnly([
        "roomId", "topicId", "title", "body", "authorUid",
        "moderationStatus", "moderationAuditId", "createdAt", "updatedAt"
      ]) &&
      c.keys().hasAll([
        "roomId", "title", "body", "authorUid",
        "moderationStatus", "moderationAuditId", "createdAt", "updatedAt"
      ]) &&
      c.roomId is string &&
      c.authorUid == request.auth.uid &&
      c.body is string && c.body.size() >= 5 && c.body.size() <= 4000 &&
      c.moderationStatus == "pending" &&
      c.moderationAuditId == "none" &&
      c.createdAt == request.time && c.updatedAt == request.time &&
      ((kind == "topic" &&
        !("topicId" in c) && c.title is string && c.title.size() >= 5 && c.title.size() <= 140) ||
       (kind == "reply" &&
        "topicId" in c && c.topicId is string &&
        !("title" in c) &&
        exists(/databases/$(database)/documents/forumTopics/$(c.topicId)) &&
        get(/databases/$(database)/documents/forumTopics/$(c.topicId)).data.roomId == c.roomId &&
        get(/databases/$(database)/documents/forumTopics/$(c.topicId)).data.moderationStatus == "approved"));
    }
    function forumModerationPair(kind, itemId) {
      let c = request.resource.data;
      let path = /databases/$(database)/documents/forumModerationAudits/$(c.moderationAuditId);
      let audit = getAfter(path).data;
      return c.moderationAuditId != resource.data.moderationAuditId &&
        !exists(path) &&
        audit.kind == kind && audit.itemId == itemId &&
        audit.roomId == resource.data.roomId &&
        audit.actorUid == request.auth.uid &&
        audit.previousStatus == resource.data.moderationStatus &&
        audit.nextStatus == c.moderationStatus &&
        audit.changedAt == request.time;
    }
    function validModerationChange(kind, itemId) {
      return (isSuperAdmin() || forumMayModerate(resource.data.roomId)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "moderationStatus", "moderationAuditId", "updatedAt"
        ]) &&
        resource.data.moderationStatus in ["pending", "approved", "removed"] &&
        request.resource.data.moderationStatus in ["approved", "removed"] &&
        resource.data.moderationStatus != request.resource.data.moderationStatus &&
        request.resource.data.updatedAt == request.time &&
        forumModerationPair(kind, itemId);
    }
    match /forumTopics/{topicId} {
      allow read: if isSuperAdmin() ||
        (forumMayReadRoom(resource.data.roomId) &&
         (resource.data.moderationStatus == "approved" || forumModerator(resource.data.roomId)));
      allow create: if forumCanPost(request.resource.data.roomId) &&
        validForumContribution("topic");
      allow update: if validModerationChange("topic", topicId);
      allow delete: if false;
    }
    match /forumReplies/{replyId} {
      allow read: if isSuperAdmin() ||
        (forumMayReadRoom(resource.data.roomId) &&
         (resource.data.moderationStatus == "approved" || forumModerator(resource.data.roomId)));
      allow create: if forumCanPost(request.resource.data.roomId) &&
        validForumContribution("reply");
      allow update: if validModerationChange("reply", replyId);
      allow delete: if false;
    }
    match /forumModerationAudits/{eventId} {
      allow read: if isSuperAdmin();
      // The event's target, reason, timestamps and status must match the batch.
      // Enforce this for administrators as well: no forged or orphan actions.
      allow create: if (isSuperAdmin() || forumMayModerate(request.resource.data.roomId)) &&
        request.resource.data.keys().hasOnly([
          "kind", "itemId", "roomId", "actorUid", "previousStatus",
          "nextStatus", "changedAt", "reason"
        ]) &&
        request.resource.data.keys().hasAll([
          "kind", "itemId", "roomId", "actorUid", "previousStatus",
          "nextStatus", "changedAt", "reason"
        ]) &&
        request.resource.data.kind in ["topic", "reply"] &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.previousStatus in ["pending", "approved", "removed"] &&
        request.resource.data.nextStatus in ["approved", "removed"] &&
        request.resource.data.previousStatus != request.resource.data.nextStatus &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 8 &&
        request.resource.data.reason.size() <= 240 &&
        request.resource.data.changedAt == request.time &&
        ((request.resource.data.kind == "topic" &&
          getAfter(/databases/$(database)/documents/forumTopics/$(request.resource.data.itemId)).data.moderationAuditId == eventId &&
          getAfter(/databases/$(database)/documents/forumTopics/$(request.resource.data.itemId)).data.roomId == request.resource.data.roomId &&
          getAfter(/databases/$(database)/documents/forumTopics/$(request.resource.data.itemId)).data.moderationStatus == request.resource.data.nextStatus) ||
         (request.resource.data.kind == "reply" &&
          getAfter(/databases/$(database)/documents/forumReplies/$(request.resource.data.itemId)).data.moderationAuditId == eventId &&
          getAfter(/databases/$(database)/documents/forumReplies/$(request.resource.data.itemId)).data.roomId == request.resource.data.roomId &&
          getAfter(/databases/$(database)/documents/forumReplies/$(request.resource.data.itemId)).data.moderationStatus == request.resource.data.nextStatus));
      allow update, delete: if false;
    }
    function forumReportTargetValid(report) {
      return (report.targetType == "topic" &&
        exists(/databases/$(database)/documents/forumTopics/$(report.targetId)) &&
        get(/databases/$(database)/documents/forumTopics/$(report.targetId)).data.roomId == report.roomId &&
        get(/databases/$(database)/documents/forumTopics/$(report.targetId)).data.moderationStatus == "approved") ||
        (report.targetType == "reply" &&
        exists(/databases/$(database)/documents/forumReplies/$(report.targetId)) &&
        get(/databases/$(database)/documents/forumReplies/$(report.targetId)).data.roomId == report.roomId &&
        get(/databases/$(database)/documents/forumReplies/$(report.targetId)).data.moderationStatus == "approved");
    }
    match /forumReports/{reportId} {
      allow read: if isSuperAdmin() ||
        (forumMayReadRoom(resource.data.roomId) &&
         (forumModerator(resource.data.roomId) || resource.data.reporterUid == request.auth.uid));
      // One immutable report per member and target. Reject forged target IDs.
      allow create: if forumApprovedAdult() &&
        forumMayReadRoom(request.resource.data.roomId) &&
        reportId == request.auth.uid + "__" + request.resource.data.targetType + "__" + request.resource.data.targetId &&
        forumReportTargetValid(request.resource.data) &&
        request.resource.data.keys().hasOnly([
          "roomId", "targetType", "targetId", "reporterUid", "reason", "createdAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "roomId", "targetType", "targetId", "reporterUid", "reason", "createdAt"
        ]) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.targetType in ["topic", "reply"] &&
        request.resource.data.targetId is string &&
        request.resource.data.reason in ["spam", "harassment", "privacy", "unsafe", "other"] &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Group ids are membership grant attributes, not a separate writable roster.
    // Old marker remains denied if any legacy /forumRoomMembers documents exist.
    match /forumRoomMembers/{memberId} { allow read, write: if false; }

    // Session state is exclusively managed by the authenticated Worker.
    match /{collection}/{document=**} {
      allow read: if collection != "adminSupportSessions" && collection != "trafficSignIns" && !(collection in ["forumRooms", "forumRoomAudits", "forumTopics", "forumReplies", "forumRoomMembers", "forumAccessGrants", "forumGrantAudits", "forumModerationAudits", "forumReports", "forumReleaseControls", "forumReleaseControlAudits"]) && !isHomeLearningReviewCollection(collection) && isSuperAdmin();
      allow delete: if collection != "adminSupportSessions" && collection != "trafficSignIns" && !(collection in ["forumRooms", "forumRoomAudits", "forumTopics", "forumReplies", "forumRoomMembers", "forumAccessGrants", "forumGrantAudits", "forumModerationAudits", "forumReports", "forumReleaseControls", "forumReleaseControlAudits"]) && !isHomeLearningReviewCollection(collection) && isSuperAdmin() && !resource.data.keys().hasAny(["communicationHistory", "lastCommunicationAt"]);
      allow create: if collection != "adminSupportSessions" && collection != "trafficSignIns" && !(collection in ["forumRooms", "forumRoomAudits", "forumTopics", "forumReplies", "forumRoomMembers", "forumAccessGrants", "forumGrantAudits", "forumModerationAudits", "forumReports", "forumReleaseControls", "forumReleaseControlAudits"]) && !isHomeLearningReviewCollection(collection) && isSuperAdmin() &&
        !request.resource.data.keys().hasAny(["communicationHistory", "lastCommunicationAt"]);
      allow update: if collection != "adminSupportSessions" && collection != "trafficSignIns" && !(collection in ["forumRooms", "forumRoomAudits", "forumTopics", "forumReplies", "forumRoomMembers", "forumAccessGrants", "forumGrantAudits", "forumModerationAudits", "forumReports", "forumReleaseControls", "forumReleaseControlAudits"]) && !isHomeLearningReviewCollection(collection) && isSuperAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["communicationHistory", "lastCommunicationAt"]);
    }
  }
}
