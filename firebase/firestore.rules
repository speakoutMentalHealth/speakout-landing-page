rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userExists() ? userDoc().data.role : "";
    }

    function userSchoolId() {
      return userExists() ? userDoc().data.schoolId : "";
    }

    function isApproved() {
      return userExists() &&
        userDoc().data.approved == true &&
        userDoc().data.status == "approved";
    }

    function isSuperAdmin() {
      return isApproved() &&
        (userRole() == "super_admin" || userRole() == "admin");
    }

    function isSchoolAdmin() {
      return isApproved() && userRole() == "school_admin";
    }

    function isTeacher() {
      return isApproved() && userRole() == "teacher";
    }

    function isParent() {
      return isApproved() && userRole() == "parent";
    }

    function isStudent() {
      return isApproved() && userRole() == "student";
    }

    function isAmbassador() {
      return isApproved() && userRole() == "ambassador";
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;

      allow read: if isApproved() &&
        (
          request.auth.uid == userId ||
          isSuperAdmin() ||
          (
            isSchoolAdmin() &&
            resource.data.schoolId == userSchoolId()
          )
        );

      allow update: if isApproved() &&
        (
          request.auth.uid == userId ||
          isSuperAdmin() ||
          (
            isSchoolAdmin() &&
            resource.data.schoolId == userSchoolId()
          )
        );

      allow delete: if isSuperAdmin();
    }

    match /schools/{schoolId} {
      allow create: if isSignedIn();

      allow read: if isApproved() &&
        (
          isSuperAdmin() ||
          (
            isSchoolAdmin() &&
            userSchoolId() == schoolId
          ) ||
          (
            (isTeacher() || isParent() || isStudent()) &&
            userSchoolId() == schoolId
          )
        );

      allow update: if isSuperAdmin() ||
        (
          isSchoolAdmin() &&
          userSchoolId() == schoolId
        );

      allow delete: if isSuperAdmin();
    }

    match /parentStudentLinks/{linkId} {
      allow create: if isApproved() && (isParent() || isSchoolAdmin() || isSuperAdmin());

      allow read: if isApproved() &&
        (
          isSuperAdmin() ||
          isSchoolAdmin() ||
          resource.data.parentId == request.auth.uid ||
          resource.data.studentId == request.auth.uid
        );

      allow update, delete: if isSuperAdmin() || isSchoolAdmin();
    }

    match /books/{bookId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    match /parentResources/{resourceId} {
      allow read: if isApproved() && (isParent() || isSchoolAdmin() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /teacherResources/{resourceId} {
      allow read: if isApproved() && (isTeacher() || isSchoolAdmin() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /studentResources/{resourceId} {
      allow read: if isApproved() && (isStudent() || isTeacher() || isSchoolAdmin() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /schoolResources/{resourceId} {
      allow read: if isApproved() &&
        (
          isSuperAdmin() ||
          (
            resource.data.schoolId == userSchoolId() &&
            (isSchoolAdmin() || isTeacher() || isParent() || isStudent())
          )
        );

      allow write: if isSuperAdmin() ||
        (
          isSchoolAdmin() &&
          request.resource.data.schoolId == userSchoolId()
        );
    }

    match /workshops/{workshopId} {
      allow read: if isApproved() &&
        (
          isSuperAdmin() ||
          (
            resource.data.schoolId == userSchoolId() &&
            (isSchoolAdmin() || isTeacher() || isParent() || isStudent())
          )
        );

      allow create, update, delete: if isSuperAdmin() ||
        (
          isSchoolAdmin() &&
          request.resource.data.schoolId == userSchoolId()
        );
    }

    match /courses/{courseId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    match /courseModules/{moduleId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    match /courseLessons/{lessonId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    /* PRIVATE ANSWER KEYS.
       Cloud Functions Admin SDK bypasses these rules entirely.
       No browser/client may ever read or write this collection. */
    match /courseAssessments/{assessmentId} {
      allow read, write: if false;
    }

    /* Learners may READ their own progress. INTERNAL-course progress may
       no longer be WRITTEN directly by clients — it changes only via
       Cloud Functions (getLearningState / markLessonComplete /
       getAssessment / submitAssessment in functions/index.js), which use
       the Admin SDK and so are unaffected by the restriction below.
       EXTERNAL-course tracking markers (type == "external-course",
       written by external-learning-submit.html) remain learner-writable:
       they carry no certificate authority on their own — certificates
       always require isSuperAdmin() to create (see below), so this
       cannot be used to self-issue a certificate, only to update the
       learner's own dashboard display. */
    match /userProgress/{progressId} {
      allow read: if isApproved() &&
        (
          resource.data.userId == request.auth.uid ||
          isSuperAdmin()
        );

      allow create, update: if isApproved() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type == "external-course";

      allow create, update, delete: if isSuperAdmin();
    }

    /* Certificates remain publicly readable for verification
       (verify-certificate.html / certificate-view.html). Learners can
       no longer create their own certificates — Cloud Functions issue
       them with the Admin SDK after server-side grading or admin
       review of an external submission. */
    match /certificates/{certificateId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /certificateTemplates/{templateId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    /* Learners submit proof of an externally-completed course here, and
       may resubmit after a rejection (external-learning-submit.html
       always writes status "pending_review" / verificationStatus
       "pending" on every submit — first-time or resubmit). That's the
       only state a learner's own write may ever set: they cannot write
       "approved" into their own record, so self-approval is impossible.
       Only Cloud Functions (reviewExternalCertificate) or an admin may
       move a record to "approved"/"rejected". */
    match /externalLearningRecords/{recordId} {
      allow create, update: if isApproved() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "pending_review" &&
        request.resource.data.verificationStatus == "pending";

      allow read: if isApproved() &&
        (
          resource.data.userId == request.auth.uid ||
          isSuperAdmin()
        );

      allow update, delete: if isSuperAdmin();
    }

    match /contributors/{contributorId} {
      allow read: if isApproved();
      allow write: if isSuperAdmin();
    }

    match /contributorApplications/{applicationId} {
      allow create: if isSignedIn();

      allow read, update, delete: if isSuperAdmin();
    }

    match /kiddiesResources/{resourceId} {
      allow read: if isApproved() && (isStudent() || isParent() || isTeacher() || isSchoolAdmin() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /homepageMedia/{mediaId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /newsEvents/{eventId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow create: if isSignedIn();

      allow read: if isSuperAdmin() ||
        (
          isApproved() &&
          resource.data.userId == request.auth.uid
        );

      allow update, delete: if isSuperAdmin();
    }

    match /donations/{donationId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /schoolApplications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
