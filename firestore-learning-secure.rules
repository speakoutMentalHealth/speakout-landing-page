rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasApprovedProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (userProfile().status == "approved" || userProfile().approved == true);
    }

    function isAdmin() {
      return hasApprovedProfile() &&
        (userProfile().role == "admin" || userProfile().role == "super_admin");
    }

    /* Keep your existing rules for schools, users, books, media, etc.
       Replace/add ONLY the learning-security blocks below. */

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* PRIVATE ANSWER KEYS.
       Cloud Functions Admin SDK bypasses Firestore client rules.
       No browser/client receives this collection. */
    match /courseAssessments/{assessmentId} {
      allow read, write: if false;
    }

    /* Learners may READ their progress, but may no longer WRITE it directly.
       Progression is changed only by Cloud Functions. */
    match /userProgress/{progressId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create, update, delete: if isAdmin();
    }

    /* Certificates remain publicly readable for verification.
       Learners can no longer create/edit their own certificates.
       Cloud Functions creates them with Admin SDK. */
    match /certificates/{certificateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
