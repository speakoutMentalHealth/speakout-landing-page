{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "speakout-platform-api-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "FIREBASE_CLIENT_EMAIL",
      "FIREBASE_PRIVATE_KEY",
      "CLOUDINARY_CLOUD_NAME",
      "CLOUDINARY_API_KEY",
      "CLOUDINARY_API_SECRET",
      "RESEND_API_KEY"
    ]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "speakout-portal-staging",
    "RESEND_FROM_EMAIL": "SpeakOut On The Move <on-the-move@speakoutmentalhealth.org>",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5000,http://localhost:5000,https://speakout-portal-staging.web.app,https://speakout-portal-staging.firebaseapp.com"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
