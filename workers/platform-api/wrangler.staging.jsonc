{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "speakout-platform-api-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "vars": {
    "FIREBASE_PROJECT_ID": "speakout-portal-staging",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5000,http://localhost:5000,https://speakout-portal-staging.web.app,https://speakout-portal-staging.firebaseapp.com"
  }
}
