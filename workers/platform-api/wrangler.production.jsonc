{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "speakout-platform-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "FIREBASE_PROJECT_ID": "speaakout-portal",
    "RESEND_FROM_EMAIL": "SpeakOut On The Move <on-the-move@speakoutmentalhealth.org>",
    "ALLOWED_ORIGINS": "https://speakoutmentalhealth.org,https://www.speakoutmentalhealth.org,https://speaakout-portal.web.app,https://speaakout-portal.firebaseapp.com",
    "SPOTIFY_SHOW_ID": "4Z8Ua9vAYLT5YJEWYV1gfx",
    "SPOTIFY_RSS_URL": "https://anchor.fm/s/f8d8cfa4/podcast/rss",
    "SPOTIFY_MARKET": "US"
  },
  "r2_buckets": [
    {
      "binding": "EVIDENCE_BUCKET",
      "bucket_name": "speakout-private-evidence"
    }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
