{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "speakout-platform-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "FIREBASE_CLIENT_EMAIL",
      "FIREBASE_PRIVATE_KEY",
      "CLOUDINARY_CLOUD_NAME",
      "CLOUDINARY_API_KEY",
      "CLOUDINARY_API_SECRET"
    ]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "speaakout-portal",
    "ALLOWED_ORIGINS": "https://speakoutmentalhealth.org,https://www.speakoutmentalhealth.org,https://speaakout-portal.web.app,https://speaakout-portal.firebaseapp.com"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
