<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin Payments | SpeakOut Admin</title>
<link rel="icon" type="image/png" href="logo.png">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="admin-shared.css">
</head>
<body>
<header class="nav"><div class="container nav-inner">
<a class="brand" href="admin-dashboard.html"><img src="logo.png" alt="SpeakOut"><div>SpeakOut<small>Admin Control</small></div></a>
<button class="menu" onclick="document.body.classList.toggle('menu-open')">☰</button>
<nav class="nav-links">
<a class="btn soft" href="admin-dashboard.html">Home</a>
<a class="btn soft" href="admin-users.html">Users</a>
<a class="btn soft" href="admin-schools.html">Schools</a>
<a class="btn soft" href="admin-books.html">Books</a>
<a class="btn soft" href="admin-courses.html">Courses</a>
<a class="btn soft" href="admin-certificates.html">Certificates</a>
<a class="btn soft" href="admin-activities.html">Activities</a>
<a class="btn soft" href="admin-reports.html">Reports</a>
<a class="btn gold" href="executive-dashboard.html">Executive</a>
<button class="btn dark" id="logoutBtn">Logout</button>
</nav></div></header>
<main>
<section class="hero"><div class="container"><span class="kicker">Admin Area</span><h1>Admin Payments</h1><p>Track sustainability fees, revenue and school payment status.</p></div></section>

<section><div class="container grid g5"><div class="card metric"><strong id="m1">0</strong><span>Records</span></div><div class="card metric"><strong id="m2">0</strong><span>Paid</span></div><div class="card metric"><strong id="m3">0</strong><span>Pending</span></div><div class="card metric"><strong id="m4">₦0</strong><span>Revenue</span></div><div class="card metric"><strong id="m5">₦0</strong><span>Expected</span></div></div></section>
<section><div class="container grid g2"><div class="panel"><span class="label">Add Payment</span><form class="form-grid" id="f"><input id="schoolName" placeholder="School name" required><input id="state" placeholder="State"><input id="amount" type="number" min="0" placeholder="Amount" required><input id="studentsPaid" type="number" min="0" placeholder="Students paid"><input id="term" placeholder="Term"><input id="session" placeholder="Academic session"><select id="status"><option>paid</option><option>pending</option><option>overdue</option><option>failed</option></select><input id="paymentDate" type="date"><textarea class="full" id="notes" placeholder="Notes"></textarea><button class="btn primary full">Save Payment</button></form><div id="msg" class="message"></div></div><div class="panel"><span class="label">By Status</span><div id="bars"></div></div></div></section>
<section><div class="container"><div class="panel"><span class="label">Payment Log</span><div class="controls"><input id="search" placeholder="Search..."><select id="filter"><option value="all">All Status</option><option>paid</option><option>pending</option><option>overdue</option><option>failed</option></select><button class="btn ghost" id="refresh">Refresh</button></div><div class="table-wrap"><table><thead><tr><th>School</th><th>Amount</th><th>Students</th><th>Term</th><th>Session</th><th>Date</th><th>Status</th></tr></thead><tbody id="rows"></tbody></table></div></div></div></section>

</main>
<footer class="footer"><div class="container">SpeakOut Admin • <a href="index.html">Back Home</a></div></footer>
<script type="module" src="auth-guard.js"></script>
<script type="module">
import { SO } from "./admin-shared.js";

let rows=[];async function load(){rows=await SO.getAll("schoolPayments");m1.textContent=SO.num(rows.length);m2.textContent=SO.num(rows.filter(r=>r.status==="paid").length);m3.textContent=SO.num(rows.filter(r=>r.status==="pending").length);m4.textContent=SO.money(rows.filter(r=>r.status==="paid").reduce((a,r)=>a+Number(r.amount||0),0));m5.textContent=SO.money(rows.reduce((a,r)=>a+Number(r.amount||0),0));SO.bars("bars",SO.by(rows,"status"));render()}
function render(){let out=SO.filter(rows,search.value,["schoolName","term","session","state"]).filter(r=>filter.value==="all"||r.status===filter.value);document.getElementById("rows").innerHTML=out.length?out.map(r=>`<tr><td>${SO.safe(r.schoolName)}</td><td>${SO.money(r.amount)}</td><td>${SO.num(r.studentsPaid)}</td><td>${SO.safe(r.term)}</td><td>${SO.safe(r.session)}</td><td>${SO.safe(r.paymentDate)}</td><td>${SO.badge(r.status)}</td></tr>`).join(""):`<tr><td colspan="7">No payments.</td></tr>`}
f.onsubmit=async e=>{e.preventDefault();await SO.addDoc(SO.collection(SO.db,"schoolPayments"),{schoolName:schoolName.value,state:state.value,amount:+amount.value||0,studentsPaid:+studentsPaid.value||0,term:term.value,session:session.value,status:status.value,paymentDate:paymentDate.value,notes:notes.value,createdAt:SO.serverTimestamp(),updatedAt:SO.serverTimestamp()});f.reset();SO.msg("msg","Payment saved.");load()};search.oninput=render;filter.onchange=render;refresh.onclick=load;load();

</script>
</body>
</html>