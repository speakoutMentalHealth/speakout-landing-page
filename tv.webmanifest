{
  "id": "tv.html",
  "name": "SpeakOut TV",
  "short_name": "SpeakOut TV",
  "description": "Youth mental health conversations, real stories, podcasts, live programmes and practical wellbeing content.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "tv.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#05101d",
  "theme_color": "#05101d",
  "categories": [
    "education",
    "entertainment",
    "health"
  ],
  "prefer_related_applications": false,
  "icons": [
